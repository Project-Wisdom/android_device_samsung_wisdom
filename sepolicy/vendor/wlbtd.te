type wlbtd, domain;
type wlbtd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(wlbtd)

set_prop(wlbtd, vendor_wlbtd_prop)

allow wlbtd vendor_wlbtd_device:chr_file rw_file_perms;
allow wlbtd self:netlink_generic_socket create_socket_perms_no_ioctl;
allow wlbtd self:netlink_socket create_socket_perms_no_ioctl;
allow wlbtd self:capability sys_resource;

r_dir_file(wlbtd, sysfs_wifi)
allow wlbtd sysfs_wifi_writable:file rw_file_perms;
r_dir_file(wlbtd, vendor_wlbtd_debugfs)

allow wlbtd conn_vendor_data_file:dir rw_dir_perms;
allow wlbtd conn_vendor_data_file:file create_file_perms;
allow wlbtd vendor_wlbtd_log_file:dir create_dir_perms;
allow wlbtd vendor_wlbtd_log_file:file create_file_perms;
allow wlbtd log_vendor_data_file:dir { getattr search };

allow wlbtd vendor_shell_exec:file rx_file_perms;
allow wlbtd vendor_toolbox_exec:file rx_file_perms;

allow wlbtd kmsg_device:chr_file { getattr open read };
allow wlbtd kernel:system syslog_read;
allow wlbtd proc:file { getattr open read };
