type init_sensor_factory, domain;
type init_sensor_factory_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(init_sensor_factory)

allow init_sensor_factory app_efs_file:dir create_dir_perms;
allow init_sensor_factory app_efs_file:file create_file_perms;
allow init_sensor_factory efs_file:dir search;
allow init_sensor_factory mnt_vendor_file:dir search;
allow init_sensor_factory vendor_shell_exec:file rx_file_perms;
allow init_sensor_factory vendor_toolbox_exec:file rx_file_perms;
